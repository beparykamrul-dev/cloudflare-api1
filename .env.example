# Runtime
FTN_ENVIRONMENT=development
PORT=8080

# PostgreSQL
DATABASE_URL=postgresql://ftn:change-me@127.0.0.1:5432/ftn_control
DB_POOL_MAX=10
DATABASE_SSL=false

# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TIMEOUT_MS=15000

# Authentication
FTN_AUTH_ENABLED=true
FTN_AUTH_ALLOW_ROLE_HEADERS=false
FTN_API_TOKENS_JSON=

# GitHub deployment integration
GITHUB_ACTIONS_TOKEN=
GITHUB_DEPLOY_WORKFLOW=deploy.yml
GITHUB_WEBHOOK_SECRET=
FTN_DEPLOY_CALLBACK_SECRET=
GITHUB_ACTIONS_TIMEOUT_MS=15000
FTN_PRODUCTION_APPROVAL_REQUIRED=true
FTN_DEPLOYMENT_LEASE_SECONDS=900

# Security / limits
FTN_TRUST_PROXY=false
FTN_MAX_BODY_BYTES=1048576
FTN_RATE_LIMIT_MAX=120
FTN_RATE_LIMIT_WINDOW_MS=60000
FTN_RATE_LIMIT_MAX_BUCKETS=10000
FTN_INVENTORY_CACHE_TTL_MS=30000

# GitHub Actions environment secrets (configure in GitHub Environment, not .env)
# FTN_DEPLOY_CALLBACK_URL
# FTN_DEPLOY_CALLBACK_SECRET
# FTN_DEPLOY_HEALTH_URL

# Metrics are protected in production; public is development-only.
FTN_METRICS_PUBLIC=false
