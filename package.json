{
  "name": "ftn-cloudflare-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate:config": "node scripts/validate-config.mjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "auth:token": "tsx scripts/create-api-token.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "cloudflare": "^4.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
